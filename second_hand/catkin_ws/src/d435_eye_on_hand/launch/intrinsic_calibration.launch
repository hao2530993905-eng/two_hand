<?xml version="1.0"?>
<launch>
  <arg name="serial_no" default="135622076024"/>
  <arg name="color_width" default="1280"/>
  <arg name="color_height" default="720"/>
  <arg name="color_fps" default="30"/>
  <arg name="charuco_cols" default="7"/>
  <arg name="charuco_rows" default="10"/>
  <!-- Printed 100 mm check line measured 96.31 mm: scale = 0.9631. -->
  <arg name="square_size" default="0.0240775"/>
  <arg name="marker_size" default="0.0173358"/>
  <arg name="aruco_dict" default="5x5_250"/>
  <arg name="start_camera" default="true"/>

  <include if="$(arg start_camera)" file="$(find d435_eye_on_hand)/launch/d435_raw.launch">
    <arg name="serial_no" value="$(arg serial_no)"/>
    <arg name="color_width" value="$(arg color_width)"/>
    <arg name="color_height" value="$(arg color_height)"/>
    <arg name="color_fps" value="$(arg color_fps)"/>
    <arg name="enable_depth" value="false"/>
  </include>

  <node pkg="camera_calibration" type="cameracalibrator.py"
        name="d435_color_intrinsic_calibrator" output="screen"
        launch-prefix="/usr/bin/python3"
        args="--pattern charuco --size $(arg charuco_cols)x$(arg charuco_rows) --square $(arg square_size) --charuco_marker_size $(arg marker_size) --aruco_dict $(arg aruco_dict) --camera_name d435_color --no-service-check image:=/d435/color/image_raw camera:=/d435/color"/>
</launch>
