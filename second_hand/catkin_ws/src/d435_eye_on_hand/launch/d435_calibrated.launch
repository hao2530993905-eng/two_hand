<?xml version="1.0"?>
<launch>
  <arg name="serial_no" default="135622076024"/>
  <arg name="camera_name" default="d435"/>
  <arg name="color_width" default="1280"/>
  <arg name="color_height" default="720"/>
  <arg name="color_fps" default="30"/>
  <arg name="enable_depth" default="false"/>
  <arg name="align_depth" default="false"/>
  <arg name="enable_sync" default="false"/>
  <arg name="intrinsics_file" default="$(find d435_eye_on_hand)/config/d435_color_intrinsics.yaml"/>

  <!-- This rosparam load intentionally fails until Phase 1 has produced a
       measured D435 calibration file. Never substitute D455 intrinsics. -->
  <group>
    <remap from="/$(arg camera_name)/color/camera_info"
           to="/$(arg camera_name)/color/camera_info_factory"/>
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
      <arg name="serial_no" value="$(arg serial_no)"/>
      <arg name="camera" value="$(arg camera_name)"/>
      <arg name="enable_color" value="true"/>
      <arg name="enable_depth" value="$(arg enable_depth)"/>
      <arg name="enable_infra" value="false"/>
      <arg name="enable_infra1" value="false"/>
      <arg name="enable_infra2" value="false"/>
      <arg name="align_depth" value="$(arg align_depth)"/>
      <arg name="enable_sync" value="$(arg enable_sync)"/>
      <arg name="color_width" value="$(arg color_width)"/>
      <arg name="color_height" value="$(arg color_height)"/>
      <arg name="color_fps" value="$(arg color_fps)"/>
    </include>
  </group>

  <node pkg="d435_eye_on_hand" type="camera_info_override.py"
        name="d435_color_camera_info_override" output="screen" required="true">
    <rosparam command="load" file="$(arg intrinsics_file)"/>
    <param name="input_topic" value="/$(arg camera_name)/color/camera_info_factory"/>
    <param name="output_topic" value="/$(arg camera_name)/color/camera_info"/>
  </node>
</launch>
