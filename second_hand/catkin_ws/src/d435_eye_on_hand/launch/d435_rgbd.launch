<?xml version="1.0"?>
<launch>
  <!-- D435 RGB-D entry point for depth-background detection.
       It keeps the measured color intrinsics while enabling synchronized,
       color-aligned depth under the /d435 namespace. -->
  <arg name="serial_no" default="135622076024"/>
  <arg name="color_width" default="1280"/>
  <arg name="color_height" default="720"/>
  <arg name="color_fps" default="30"/>

  <include file="$(find d435_eye_on_hand)/launch/d435_calibrated.launch">
    <arg name="serial_no" value="$(arg serial_no)"/>
    <arg name="camera_name" value="d435"/>
    <arg name="color_width" value="$(arg color_width)"/>
    <arg name="color_height" value="$(arg color_height)"/>
    <arg name="color_fps" value="$(arg color_fps)"/>
    <arg name="enable_depth" value="true"/>
    <arg name="align_depth" value="true"/>
    <arg name="enable_sync" value="true"/>
  </include>
</launch>
